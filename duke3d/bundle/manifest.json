{
  "$schema": "epoca:experimental-product/v1",
  "$v": 1,
  "kind": "framebuffer",
  "displayName": "Duke Nukem 3D Engine",
  "description": "Run Duke Nukem 3D shareware in Epoca with a sandboxed PolkaVM engine.",
  "appVersion": [0, 1, 0],
  "runtime": {
    "kind": "polkavm",
    "entrypoint": "app.polkavm"
  },
  "modalities": {
    "framebuffer": {
      "abiVersion": 1,
      "controls": [
        "WASD Move",
        "Mouse Look",
        "Arrows Look",
        "Mouse 1 / Ctrl Fire",
        "Space Jump · E Use",
        "Esc Menu"
      ]
    },
    "generalInput": {
      "handlers": [
        {
          "kind": "content",
          "types": [
            "application/x-duke3d-grp",
            "application/x-duke3d-shareware-zip"
          ],
          "traits": ["duke3d-grp"],
          "actions": ["open"]
        }
      ]
    }
  },
  "contentSlots": [
    {
      "id": "grp",
      "required": true,
      "accepts": [
        "application/x-duke3d-grp",
        "application/x-duke3d-shareware-zip"
      ],
      "traits": ["duke3d-grp"],
      "delivery": "read-only-mount",
      "mount": "game/duke3d.grp",
      "default": {
        "product": "3dduke13-zip",
        "item": "shareware-grp",
        "version": [1, 3, 0]
      }
    }
  ]
}
