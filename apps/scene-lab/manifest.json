{
  "$v": 2,
  "kind": "app",
  "appVersion": [0, 1, 0],
  "runtime": {
    "kind": "polkavm",
    "abiVersion": 1,
    "entrypoint": "app.polkavm"
  },
  "capabilities": {
    "graphics": {
      "abiVersion": 1,
      "profile": "webgpu-raster",
      "requiredFeatures": [],
      "requiredLimits": {
        "maxTextureDimension2D": 4096,
        "maxBufferSize": 2097152,
        "maxBindingsPerBindGroup": 3
      }
    },
    "deviceInput": {
      "abiVersion": 1,
      "requiredFeatures": ["pointer", "keyboard"]
    }
  }
}
